# 4. CHUẨN HÓA VĂN BẢN & ĐẾM TỪ KHÓA
# ------------------------------------------------------------
def normalize_text(text: str) -> str:
    """Chuẩn hóa văn bản: lowercase, gộp khoảng trắng thừa (dùng để đếm tổng số từ)."""
    text = text.lower()
    text = re.sub(r"\s+", " ", text)
    return text
 
 
def normalize_text_for_keywords(text: str) -> str:
    """Chuẩn hóa RIÊNG cho đếm từ khóa: NFC-normalize + gộp khoảng trắng,
    KHÔNG lowercase (để giữ phân biệt hoa/thường cho từ viết tắt như AI, 5G, IoT)."""
    text = unicodedata.normalize("NFC", text)
    text = re.sub(r"\s+", " ", text)
    return text
 
 
def count_keywords(text: str, keyword_terms: dict) -> dict:
    """
    Đếm số lần xuất hiện của từng từ khóa (kể cả alias), dùng word-boundary
    để tránh khớp nhầm substring (vd "ai" không ăn vào "hải", "mai"...).
    Từ ngắn (<=SHORT_TERM_MAX_LEN) so khớp giữ nguyên hoa/thường.
    """
    counts = {}
    for keyword, term_infos in keyword_terms.items():
        matched_spans = set()
        for term, case_sensitive in term_infos:
            flags = re.UNICODE if case_sensitive else re.IGNORECASE | re.UNICODE
            pattern = re.compile(r"\b" + re.escape(term) + r"\b", flags)
            for m in pattern.finditer(text):
                matched_spans.add(m.span())
        counts[keyword] = len(matched_spans)
    return counts
 
 
def find_keyword_occurrences(text: str, keyword_terms: dict, window: int = CONTEXT_WINDOW) -> list:
    """Tìm từng vị trí từ khóa/alias xuất hiện, trích đoạn ngữ cảnh xung quanh
    để kiểm tra thủ công (giống hệt logic word-boundary của count_keywords)."""
    occurrences = []
    for keyword, term_infos in keyword_terms.items():
        seen_spans = set()
        for term, case_sensitive in term_infos:
            flags = re.UNICODE if case_sensitive else re.IGNORECASE | re.UNICODE
            pattern = re.compile(r"\b" + re.escape(term) + r"\b", flags)
            for m in pattern.finditer(text):
                if m.span() in seen_spans:
                    continue
                seen_spans.add(m.span())
                start = max(0, m.start() - window)
                end = min(len(text), m.end() + window)
                context = text[start:end].replace("\n", " ").strip()
                occurrences.append({
                    "keyword": keyword,
                    "matched_term": term,
                    "context": f"…{context}…",
                })
    return occurrences
 
 
def count_total_words(text: str) -> int:
    """Đếm tổng số từ trong văn bản (ước lượng, tách theo khoảng trắng)."""
    return len(text.split())
 
 
def parse_filename(filename: str):
    """Tách Mã CK và Năm từ tên file, định dạng: MACK_NAM.pdf -> ("MACK", NAM)."""
    base = os.path.splitext(os.path.basename(filename))[0]
    match = re.match(r"([A-Za-z0-9]+)[_\-]\s*(\d{4})", base)
    if match:
        return match.group(1).upper(), int(match.group(2))
    return base, None
 
 
def file_sha256(filepath: str) -> str:
    """Tính mã băm SHA256 của file, dùng để phát hiện file trùng nội dung."""
    h = hashlib.sha256()
    try:
        with open(filepath, "rb") as f:
            for chunk in iter(lambda: f.read(8192), b""):
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return ""
 
 
