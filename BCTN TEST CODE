    detail_rows = []
    occurrence_rows = []
    report_status_rows = []
    file_inventory_rows = []
    company_year_map = collections.defaultdict(list)
 
    for idx, pdf_path in enumerate(pdf_files):
        filename = os.path.basename(pdf_path)
        ma_ck, nam = parse_filename(filename)
        company_year_map[(ma_ck, nam)].append(filename)
 
        print(f"[{idx + 1}/{len(pdf_files)}] Đang xử lý: {filename}  (Mã CK: {ma_ck}, Năm: {nam})")
 
        file_inventory_rows.append({
            "Ma_CK": ma_ck, "Nam": nam, "File": filename,
            "Duong_dan": pdf_path,
            "SHA256": file_sha256(pdf_path),
            "Dung_luong_bytes": os.path.getsize(pdf_path),
        })
 
        extraction = extract_text_from_pdf(pdf_path)
        raw_text = extraction["text"]
 
        norm_text = normalize_text(raw_text)
        total_words = count_total_words(norm_text)
 
        kw_text = normalize_text_for_keywords(raw_text)
        kw_counts = count_keywords(kw_text, KEYWORD_TERMS)
        total_kw_count = sum(kw_counts.values())
        unique_kw_count = sum(1 for c in kw_counts.values() if c > 0)
 
        # ----- Report_Status -----
        report_status_rows.append({
            "Ma_CK": ma_ck, "Nam": nam, "File": filename,
            "Trang_thai": extraction["status"],
            "Loi": extraction["message"],
            "So_trang": extraction["page_count"],
            "So_ky_tu_trich_duoc_goc": extraction["native_chars"],
            "So_trang_da_OCR": len(extraction["ocr_pages"]),
            "So_trang_OCR_loi": len(extraction["ocr_failed_pages"]),
            "Tong_so_tu": total_words,
            "Tong_tan_suat_tu_khoa": total_kw_count,
        })
 
        # ----- Keyword_Counts -----
        for group_name, kws in KEYWORD_GROUPS.items():
            for kw in kws:
                if kw_counts[kw] > 0:
                    detail_rows.append({
                        "Ma_CK": ma_ck, "Nam": nam, "File": filename,
                        "Keyword_ID": KEYWORD_ID_MAP[kw],
                        "Tu_khoa": kw,
                        "Nhom_tu_khoa": group_name,
                        "Tan_suat": kw_counts[kw],
                    })
 
        # ----- Keyword_Occurrences (có ngữ cảnh) -----
        for occ in find_keyword_occurrences(kw_text, KEYWORD_TERMS):
            occurrence_rows.append({
                "Ma_CK": ma_ck, "Nam": nam, "File": filename,
                "Keyword_ID": KEYWORD_ID_MAP[occ["keyword"]],
                "Tu_khoa": occ["keyword"],
                "Alias_khop": occ["matched_term"],
                "Nhom_tu_khoa": KEYWORD_DIMENSION_MAP[occ["keyword"]],
                "Ngu_canh": occ["context"],
            })
 
        # ----- Bank_Year_Summary -----
        digi_ln = math.log(total_kw_count + 1)
        digi_ratio = (total_kw_count / total_words) if total_words > 0 else 0
        digi_density_1000 = digi_ratio * 1000
        digi_binary = 1 if total_kw_count > 0 else 0
 
        summary_rows.append({
            "Ma_CK": ma_ck, "Nam": nam, "File": filename,
            "Trang_thai": extraction["status"],
            "So_trang": extraction["page_count"],
            "So_trang_da_OCR": len(extraction["ocr_pages"]),
            "Tong_so_tu_trong_BCTN": total_words,
            "Tong_tan_suat_tu_khoa": total_kw_count,
            "So_tu_khoa_khac_nhau_xuat_hien": unique_kw_count,
            "DIGI_ln": round(digi_ln, 4),
            "DIGI_ty_le(%)": round(digi_ratio * 100, 4),
            "DIGI_mat_do_per_1000_tu": round(digi_density_1000, 4),
            "DIGI_nhi_phan": digi_binary,
        })
 
        print(f"   -> Từ khóa: {total_kw_count} | Tổng số từ: {total_words} "
              f"| Trang OCR: {len(extraction['ocr_pages'])} | DIGI_ln = {round(digi_ln, 4)}\n")
 
    # ----- Input_Coverage -----
    all_companies = sorted(set(c for (c, y) in company_year_map if c))
    all_years = sorted(set(y for (c, y) in company_year_map if y))
    coverage_rows = []
    for c in all_companies:
        for y in all_years:
            files_found = company_year_map.get((c, y), [])
