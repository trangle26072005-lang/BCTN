SHORT_TERM_MAX_LEN = 5   # từ/cụm <= độ dài này -> so khớp giữ nguyên hoa/thường (AI, 5G, IoT, CNTT...)
NGUONG_KY_TU_SCAN = 50   # dưới ngưỡng này (ký tự/trang) -> coi là scan, chạy OCR
CONTEXT_WINDOW = 150     # số ký tự lấy ngữ cảnh trước/sau mỗi từ khóa xuất hiện
OCR_MAX_WORKERS = 4      # số luồng OCR song song
 
 
