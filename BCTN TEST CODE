        for kw in KEYWORD_ID_MAP
    ]
 
    # ----- Xuất Excel -----
    with pd.ExcelWriter(OUTPUT_FILE, engine="openpyxl") as writer:
        pd.DataFrame(summary_rows).to_excel(writer, sheet_name="Bank_Year_Summary", index=False)
        pd.DataFrame(detail_rows).to_excel(writer, sheet_name="Keyword_Counts", index=False)
