# 3. TRÍCH XUẤT TEXT TỪ PDF (có OCR song song cho trang scan)
# ------------------------------------------------------------
def extract_text_from_pdf(pdf_path: str, dpi: int = 300, max_workers: int = OCR_MAX_WORKERS) -> dict:
    """
    Trích xuất toàn bộ text từ 1 file PDF. Trang nào text quá ít (nghi scan)
    sẽ tự động OCR (chạy song song để nhanh hơn).
    Trả về dict: text, status, message, page_count, native_chars,
                 ocr_pages, ocr_failed_pages
    """
    result = {
        "text": "", "status": "Success", "message": "",
        "page_count": 0, "native_chars": 0,
        "ocr_pages": [], "ocr_failed_pages": [],
    }
    try:
        doc = fitz.open(pdf_path)
        n_pages = len(doc)
        result["page_count"] = n_pages
 
        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)
        results = [""] * n_pages
        ocr_jobs = []  # list of (index, PIL.Image)
 
        # Bước 1: lấy text sẵn có, render ảnh cho các trang nghi scan
        for i, page in enumerate(doc):
            page_text = page.get_text()
            result["native_chars"] += len(page_text)
            if len(page_text.strip()) < NGUONG_KY_TU_SCAN:
                pix = page.get_pixmap(matrix=matrix)
                img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
                ocr_jobs.append((i, img))
            else:
                results[i] = page_text
 
        doc.close()
 
        # Bước 2: chạy OCR song song cho các trang cần thiết
        def run_ocr(job):
            i, img = job
            try:
                text = pytesseract.image_to_string(img, lang="vie", config="--oem 3 --psm 6")
                return i, text, True
            except Exception as ocr_err:
                print(f"   [OCR LỖI] Trang {i + 1}: {ocr_err}")
                return i, "", False
 
        if ocr_jobs:
            with ThreadPoolExecutor(max_workers=max_workers) as executor:
                for i, text, ok in executor.map(run_ocr, ocr_jobs):
                    results[i] = text
                    if ok:
                        result["ocr_pages"].append(i + 1)
                    else:
                        result["ocr_failed_pages"].append(i + 1)
 
        result["text"] = "".join(results)
 
    except Exception as e:
        result["status"] = "Failed"
        result["message"] = str(e)
        print(f"  [LỖI] Không đọc được {pdf_path}: {e}")
 
    return result
 
 
