        pd.DataFrame(report_status_rows).to_excel(writer, sheet_name="Report_Status", index=False)
        pd.DataFrame(coverage_rows).to_excel(writer, sheet_name="Input_Coverage", index=False)
        pd.DataFrame(selection_issue_rows).to_excel(writer, sheet_name="Selection_Issues", index=False)
        pd.DataFrame(keyword_dict_rows).to_excel(writer, sheet_name="Keywords_Used", index=False)
        pd.DataFrame(file_inventory_rows).to_excel(writer, sheet_name="File_Inventory", index=False)
 
    print(f"\n✅ HOÀN TẤT! Kết quả đã lưu tại: {OUTPUT_FILE}")
    print("   - Bank_Year_Summary   : dùng để đưa vào Stata/R/Python chạy hồi quy")
    print("   - Keyword_Counts      : tần suất từng từ khóa theo công ty-năm")
    print("   - Keyword_Occurrences : trích đoạn ngữ cảnh, dùng để kiểm tra thủ công")
    print("   - Report_Status       : trạng thái xử lý & OCR từng file")
    print("   - Input_Coverage      : bảng công ty x năm, phát hiện năm thiếu báo cáo")
    print("   - Selection_Issues    : cảnh báo file trùng công ty-năm")
    print("   - Keywords_Used       : danh mục từ điển kèm mã ID")
    print("   - File_Inventory      : kiểm kê file gốc (đường dẫn, SHA256, dung lượng)")
 
 
if __name__ == "__main__":
    main()
