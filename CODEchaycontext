    "0123456789 .,;:!?()%-/"
)

def _garbled_score(text: str, start: int, end: int, window: int = 40) -> float:
    seg = text[max(0, start - window):end + window].strip()
    tokens = seg.split()
    if not tokens:
        return 1.0
    bad = 0
    keep_short = {"x", "o", "a", "e", "i", "u", "y"}  # ký tự đơn lẻ hợp lệ (bảng checkbox, số đếm...)
    for tok in tokens:
        core = tok.strip(".,;:!?()|-").lower()
        if not core:
            continue
        if len(core) == 1 and not core.isdigit() and core not in keep_short:
            bad += 1
            continue
        odd = sum(1 for ch in core if ch not in _VALID_VN_CHARS)
        if odd / len(core) > 0.3:
            bad += 1
    return bad / len(tokens)

def _is_garbled_context(text: str, start: int, end: int, window: int = 40, threshold: float = 0.35) -> bool:
    return _garbled_score(text, start, end, window) > threshold

def count_and_find_occurrences(text: str, keyword_terms: dict, window: int = CONTEXT_WINDOW):
    occurrences = []
    for keyword, term_infos in keyword_terms.items():
        seen_spans = set()
        for term, case_sensitive in term_infos:
            pattern = _compile_pattern(term, case_sensitive)
            for m in pattern.finditer(text):
                if (m.span() in seen_spans
                       or _is_negative_context(text, m.start())
                       or _is_document_number_context(text, m.end())):
                    continue
                if case_sensitive and _is_garbled_context(text, m.start(), m.end()):
                    continue
                if keyword == "Tài sản số" and _is_financial_statement_header(text, m.start()):   # <-- THÊM DÒNG NÀY
                    continue
                seen_spans.add(m.span())
                start, end = max(0, m.start() - window), min(len(text), m.end() + window)
                context = text[start:end].replace("\n", " ").strip()
                occurrences.append({"keyword": keyword, "matched_term": term, "context": f"…{context}…"})
    import collections
    counts = collections.Counter(o["keyword"] for o in occurrences)
    return counts, occurrences
 
 
def count_total_words(text: str) -> int:
    """Đếm tổng số từ trong văn bản (ước lượng, tách theo khoảng trắng)."""
    return len(text.split())
 
 
def parse_filename(filename: str):
    """
    Tách Mã CK và Năm từ tên file, giả định định dạng: MACK_NAM.pdf
    VD: FPT_2020.pdf -> ("FPT", 2020)
    Nếu tên file không đúng định dạng, trả về (tên file, None) và bạn
    cần bổ sung thủ công trong file Excel kết quả.
    """
    base = os.path.splitext(os.path.basename(filename))[0]
    match = re.match(r"([A-Za-z0-9]+)[_\-](\d{4})", base)
    if match:
        return match.group(1).upper(), int(match.group(2))
    return base, None
 

_progress_initialized = False
_start_time = None

def show_overall_progress(current: int, total: int, current_filename: str = "", status: str = ""):
    global _progress_initialized, _start_time

    if _start_time is None:
        _start_time = time.time()

    elapsed = time.time() - _start_time
    percent = (current / total) * 100 if total > 0 else 100
    bar_len = 30
    filled = int(bar_len * current / total) if total > 0 else bar_len
    bar = "▰" * filled + "▱" * (bar_len - filled)

    # Tính ETA dựa trên tốc độ trung bình/file đã xử lý xong
    if current > 0:
        avg_time_per_file = elapsed / current
        remaining = avg_time_per_file * (total - current)
    else:
        remaining = 0

    def fmt_time(seconds: float) -> str:
        seconds = int(seconds)
        h, rem = divmod(seconds, 3600)
        m, s = divmod(rem, 60)
        if h > 0:
            return f"{h}h{m:02d}p{s:02d}s"
        return f"{m}p{s:02d}s"

    line1 = (f"[{bar}] {percent:5.1f}% ({current}/{total} file) "
              f"| Đã chạy: {fmt_time(elapsed)} | Còn lại: ~{fmt_time(remaining)}")
    line2 = f"   -> {status}: {current_filename}"

    if _progress_initialized:
        sys.stdout.write("\x1b[2A")
    _progress_initialized = True

    sys.stdout.write("\x1b[2K" + line1 + "\n")
    sys.stdout.write("\x1b[2K" + line2 + "\n")
    sys.stdout.flush()

