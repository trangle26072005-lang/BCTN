def extract_text_from_pdf(pdf_path: str, dpi: int = 300, max_workers: int = 4) -> dict:
    """Trích xuất toàn bộ text từ 1 file PDF. Trang nào text quá ít (nghi scan) sẽ tự động OCR (song song)."""
    parts = []
    try:
        doc = fitz.open(pdf_path)
        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)
        n_pages = len(doc)
        results = [""] * n_pages
        ocr_jobs = []

        for i, page in enumerate(doc):
            blocks = page.get_text("blocks")
            seen_block_text = set()
            unique_texts = []
            for b in blocks:
                t = b[4].strip()
                if t and t not in seen_block_text:
                   seen_block_text.add(t)
                   unique_texts.append(t)
            page_text = "\n".join(unique_texts)
            if len(page_text.strip()) < 50:
                pix = page.get_pixmap(matrix=matrix)
                img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
                ocr_jobs.append((i, img))
            else:
                results[i] = page_text

        doc.close()

        def run_ocr(job):
            i, img = job
            try:
                text = pytesseract.image_to_string(img, lang="vie", config="--oem 3 --psm 6")
                return i, text
            except Exception as ocr_err:
                print(f"\n   [OCR LỖI] Trang {i + 1}: {ocr_err}")
                return i, ""

        if ocr_jobs:
            with ThreadPoolExecutor(max_workers=max_workers) as executor:
                for i, text in executor.map(run_ocr, ocr_jobs):
                    results[i] = text

        parts = results

    except Exception as e:
        print(f"\n  [LỖI] Không đọc được {pdf_path}: {e}")

    return {"text": "\n".join(parts)}
 
 
def normalize_text(text: str) -> str:
    """Chuẩn hóa văn bản: lowercase, gộp khoảng trắng thừa."""
    text = text.lower()
    text = re.sub(r"\s+", " ", text)
    return text
 
def normalize_text_for_keywords(text: str) -> str:
    text = unicodedata.normalize("NFC", text)
    text = re.sub(r"\n+", ". ", text)
    return re.sub(r"[ \t]+", " ", text)


def _compile_pattern(term: str, case_sensitive: bool):
    flags = re.UNICODE if case_sensitive else re.IGNORECASE | re.UNICODE
    return re.compile(r"(?<![\w.])" + re.escape(term) + r"(?!\w)", flags)


def _is_negative_context(text: str, pos: int) -> bool:
    before = text[max(0, pos - NEGATIVE_CONTEXT_WINDOW):pos].lower()
    return any(neg in before for neg in NEGATIVE_CONTEXT_WORDS)
def _is_document_number_context(text: str, end_pos: int, window: int = 30) -> bool:
    after = text[end_pos:end_pos + window]
    return bool(re.search(r"^[\s.|]{0,10}\d+[/.\-]\d", after))
_FINANCIAL_STATEMENT_MARKERS = [
    "bảng cân đối kế toán", "cân đối kế toán", "thuyết minh",
    "báo cáo tài chính", "mã số", "số cuối năm", "số đầu năm",
]

def _is_financial_statement_header(text: str, pos: int, window: int = 100) -> bool:
    around = text[max(0, pos - window):pos + window].lower()
    return any(marker in around for marker in _FINANCIAL_STATEMENT_MARKERS)
