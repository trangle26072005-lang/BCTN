def extract_text_from_pdf(pdf_path: str, dpi: int = 300, max_workers: int = 4) -> dict:
    """Trích xuất toàn bộ text từ 1 file PDF. Trang nào text quá ít (nghi scan) sẽ tự động OCR (song song)."""
    parts = []
    try:
        doc = fitz.open(pdf_path)
        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)
        n_pages = len(doc)
        results = [""] * n_pages
        ocr_jobs = []

        for i, page in enumerate(doc):
            page_text = page.get_text()
            if len(page_text.strip()) < 50:
                pix = page.get_pixmap(matrix=matrix)
                img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
                ocr_jobs.append((i, img))
            else:
                results[i] = page_text

        doc.close()

        def run_ocr(job):
            i, img = job
            try:
                text = pytesseract.image_to_string(img, lang="vie", config="--oem 3 --psm 6")
                return i, text
            except Exception as ocr_err:
                print(f"\n   [OCR LỖI] Trang {i + 1}: {ocr_err}")
                return i, ""

        if ocr_jobs:
            with ThreadPoolExecutor(max_workers=max_workers) as executor:
                for i, text in executor.map(run_ocr, ocr_jobs):
                    results[i] = text

        parts = results

    except Exception as e:
        print(f"\n  [LỖI] Không đọc được {pdf_path}: {e}")

    return {"text": "".join(parts)}
 
 
def normalize_text(text: str) -> str:
    """Chuẩn hóa văn bản: lowercase, gộp khoảng trắng thừa."""
    text = text.lower()
    text = re.sub(r"\s+", " ", text)
    return text
 
 
def count_keywords(text: str, keywords: list) -> dict:
    """Đếm số lần xuất hiện của từng từ khóa trong văn bản (đếm chồng lấp cho phép)."""
    text_lower = text.lower()
    counts = {}
    for kw in keywords:
        pattern = r'\b' + re.escape(kw.lower()) + r'\b'
        counts[kw] = len(re.findall(pattern, text_lower))
    return counts
 
 
def count_total_words(text: str) -> int:
    """Đếm tổng số từ trong văn bản (ước lượng, tách theo khoảng trắng)."""
    return len(text.split())
 
 
def parse_filename(filename: str):
    """
    Tách Mã CK và Năm từ tên file, giả định định dạng: MACK_NAM.pdf
    VD: FPT_2020.pdf -> ("FPT", 2020)
    Nếu tên file không đúng định dạng, trả về (tên file, None) và bạn
    cần bổ sung thủ công trong file Excel kết quả.
    """
    base = os.path.splitext(os.path.basename(filename))[0]
    match = re.match(r"([A-Za-z0-9]+)[_\-](\d{4})", base)
    if match:
        return match.group(1).upper(), int(match.group(2))
    return base, None
 

_progress_initialized = False
_start_time = None

def show_overall_progress(current: int, total: int, current_filename: str = "", status: str = ""):
    global _progress_initialized, _start_time

    if _start_time is None:
        _start_time = time.time()

    elapsed = time.time() - _start_time
    percent = (current / total) * 100 if total > 0 else 100
    bar_len = 30
    filled = int(bar_len * current / total) if total > 0 else bar_len
    bar = "▰" * filled + "▱" * (bar_len - filled)

    # Tính ETA dựa trên tốc độ trung bình/file đã xử lý xong
    if current > 0:
        avg_time_per_file = elapsed / current
        remaining = avg_time_per_file * (total - current)
    else:
        remaining = 0

    def fmt_time(seconds: float) -> str:
        seconds = int(seconds)
        h, rem = divmod(seconds, 3600)
        m, s = divmod(rem, 60)
        if h > 0:
            return f"{h}h{m:02d}p{s:02d}s"
        return f"{m}p{s:02d}s"

    line1 = (f"[{bar}] {percent:5.1f}% ({current}/{total} file) "
              f"| Đã chạy: {fmt_time(elapsed)} | Còn lại: ~{fmt_time(remaining)}")
    line2 = f"   -> {status}: {current_filename}"

    if _progress_initialized:
        sys.stdout.write("\x1b[2A")
    _progress_initialized = True

    sys.stdout.write("\x1b[2K" + line1 + "\n")
    sys.stdout.write("\x1b[2K" + line2 + "\n")
    sys.stdout.flush()

def main():
    global _progress_initialized, _start_time
    _progress_initialized = False
    _start_time = None  # reset lại mỗi lần chạy main()

    if not os.path.isdir(INPUT_FOLDER):
