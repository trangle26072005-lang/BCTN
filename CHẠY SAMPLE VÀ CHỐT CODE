def extract_text_from_pdf(pdf_path: str, dpi: int = 300, max_workers: int = 4) -> str:
    """Trích xuất toàn bộ text từ 1 file PDF. Trang nào text quá ít (nghi scan) sẽ tự động OCR (song song)."""
    parts = []
    try:
        doc = fitz.open(pdf_path)
        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)
        n_pages = len(doc)
        results = [""] * n_pages
        ocr_jobs = []  # list of (index, PIL.Image)

        # Bước 1: lấy text sẵn có, render ảnh cho các trang nghi scan
        for i, page in enumerate(doc):
            page_text = page.get_text()
            if len(page_text.strip()) < 50:
                pix = page.get_pixmap(matrix=matrix)
                img = Image.frombytes("RGB", (pix.width, pix.height), pix.samples)
                ocr_jobs.append((i, img))
            else:
                results[i] = page_text

        doc.close()

        # Bước 2: chạy OCR song song cho các trang cần thiết
        def run_ocr(job):
            i, img = job
            try:
                text = pytesseract.image_to_string(img, lang="vie", config="--oem 3 --psm 6")
                print(f"   [OCR] Đã chạy OCR cho trang {i + 1}")
                return i, text
            except Exception as ocr_err:
                print(f"   [OCR LỖI] Trang {i + 1}: {ocr_err}")
                return i, ""

        if ocr_jobs:
            with ThreadPoolExecutor(max_workers=max_workers) as executor:
                for i, text in executor.map(run_ocr, ocr_jobs):
                    results[i] = text

        parts = results

    except Exception as e:
        print(f"  [LỖI] Không đọc được {pdf_path}: {e}")

    return {"text": "".join(parts)}
def normalize_text(text: str) -> str:
    """Chuẩn hóa văn bản: lowercase, gộp khoảng trắng thừa."""
    text = text.lower()
    text = re.sub(r"\s+", " ", text)
    return text
def normalize_text_for_keywords(text: str) -> str:
    """Chuẩn hóa văn bản dùng RIÊNG cho việc đếm từ khóa: NFC-normalize +
    gộp khoảng trắng thừa, nhưng KHÔNG lowercase (để giữ phân biệt hoa/thường
    cho các từ viết tắt như AI, 5G, IoT)."""
    text = unicodedata.normalize("NFC", text)
    text = re.sub(r"\s+", " ", text)
    return text
def count_keywords(text: str, keyword_terms: dict) -> dict:
    """
    Đếm số lần xuất hiện của từng từ khóa (kể cả alias) trong văn bản.
      - Dùng \b (word-boundary) thay vì tìm substring -> "ai" không ăn vào "hải", "mai", "loại"...
      - Từ/cụm ngắn (<= SHORT_TERM_MAX_LEN, vd AI, 5G, IoT, CNTT, eKYC, B2B...) so khớp
        GIỮ NGUYÊN hoa/thường, để không lẫn "AI" (công nghệ) với "ai" (đại từ tiếng Việt).
      - Các alias của cùng 1 keyword được cộng dồn, dedupe theo vị trí khớp (span)
        để không đếm trùng nếu 2 alias cùng khớp 1 chỗ.
    """
    counts = {}
    for keyword, term_infos in keyword_terms.items():
        matched_spans = set()
        for term, case_sensitive in term_infos:
            flags = re.UNICODE if case_sensitive else re.IGNORECASE | re.UNICODE
            pattern = re.compile(r"\b" + re.escape(term) + r"\b", flags)
            for m in pattern.finditer(text):
                matched_spans.add(m.span())
        counts[keyword] = len(matched_spans)
    return counts
def count_total_words(text: str) -> int:
    """Đếm tổng số từ trong văn bản (ước lượng, tách theo khoảng trắng)."""
    return len(text.split())
 
 
def parse_filename(filename: str):
    """
    Tách Mã CK và Năm từ tên file, giả định định dạng: MACK_NAM.pdf
    VD: FPT_2020.pdf -> ("FPT", 2020)
    Nếu tên file không đúng định dạng, trả về (tên file, None) và bạn
    cần bổ sung thủ công trong file Excel kết quả.
    """
    base = os.path.splitext(os.path.basename(filename))[0]
    match = re.match(r"([A-Za-z0-9]+)[_\-](\d{4})", base)
    if match:
        return match.group(1).upper(), int(match.group(2))
    return base, None
 
 
def is_pdf_likely_scanned(text: str) -> bool:
    """Cảnh báo nếu PDF có thể là bản scan ảnh (text trích ra quá ít)."""
    return len(text.strip()) < 200
