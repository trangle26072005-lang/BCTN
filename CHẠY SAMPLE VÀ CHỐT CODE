def load_keyword_dictionary(path: str, sheet_name: str = "Keywords_Used"):
    """
    Đọc keyword_dictionary.xlsx, trả về:
      - groups: {dimension: [keyword, ...]}          -> dùng cho detail_rows như code cũ
      - terms_map: {keyword: [(term, case_sensitive), ...]}  -> keyword chính + alias, để đếm
    """
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb[sheet_name]
    header = [c.value for c in next(ws.iter_rows(min_row=1, max_row=1))]
    col = {name: i for i, name in enumerate(header)}

    groups, terms_map = {}, {}
    for row in ws.iter_rows(min_row=2, values_only=True):
        if not row or row[col["Keyword ID"]] is None:
            continue
        keyword = unicodedata.normalize("NFC", str(row[col["Keyword"]]).strip())
        dimension = row[col["Keyword Dimension"]]
        aliases_raw = row[col["Aliases"]]
        aliases = (
            [unicodedata.normalize("NFC", a.strip()) for a in aliases_raw.split(";") if a.strip()]
            if aliases_raw else []
        )

        groups.setdefault(dimension, []).append(keyword)
        all_terms = [keyword] + aliases
        terms_map[keyword] = [(t, len(t) <= SHORT_TERM_MAX_LEN) for t in all_terms]

    return groups, terms_map


